{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PBD: Setup toolchain",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/vscode.ps1",
        "-Action",
        "Setup"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "PBD: Configure",
      "type": "process",
      "command": "node",
      "args": ["tools/native.mjs", "configure"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "PBD: Build Debug",
      "type": "process",
      "command": "node",
      "args": ["tools/native.mjs", "build"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "PBD: Build Release",
      "type": "process",
      "command": "node",
      "args": ["tools/native.mjs", "build", "--release"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "PBD: Test Debug",
      "type": "process",
      "command": "node",
      "args": ["tools/native.mjs", "test"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "PBD: Test Release",
      "type": "process",
      "command": "node",
      "args": ["tools/native.mjs", "test", "--release"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "PBD: Build Wasm",
      "type": "process",
      "command": "node",
      "args": ["tools/run.mjs", "build:all"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "group": "build"
    },
    {
      "label": "PBD: Test Wasm",
      "type": "process",
      "command": "node",
      "args": ["tools/test.mjs"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test",
      "dependsOn": "PBD: Build Wasm"
    },
    {
      "label": "PBD: Build web",
      "type": "process",
      "command": "node",
      "args": ["tools/run.mjs", "build"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "PBD: Check format",
      "type": "process",
      "command": "node",
      "args": ["tools/style.mjs"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "PBD: Format C++",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/vscode.ps1",
        "-Action",
        "Format"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "PBD: Check all",
      "type": "process",
      "command": "node",
      "args": ["tools/run.mjs", "check"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "PBD: Browser tests",
      "type": "process",
      "command": "node",
      "args": ["tools/run.mjs", "test:browser"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "PBD: Serve",
      "type": "process",
      "command": "python",
      "args": ["-u", "${workspaceFolder}/tools/serve.py", "--port", "8000"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "pbd-server",
        "pattern": {
          "regexp": "^(.+):(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^PBD_SERVER_STARTING$",
          "endsPattern": "^PBD_SERVER_READY\\b"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "PBD: Rebuild and serve",
      "dependsOn": ["PBD: Build Wasm", "PBD: Serve"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
