{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PBD: C++ core tests (Debug)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/native/Debug/pbd_native_tests.exe",
      "cwd": "${workspaceFolder}",
      "args": [],
      "stopAtEntry": true,
      "externalConsole": false,
      "preLaunchTask": "PBD: Build Debug",
      "requireExactSource": true
    },
    {
      "name": "PBD: C++ contract tests (Debug)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/native/Debug/pbd_refactoring_tests.exe",
      "cwd": "${workspaceFolder}",
      "args": [],
      "stopAtEntry": true,
      "externalConsole": false,
      "preLaunchTask": "PBD: Build Debug",
      "requireExactSource": true
    },
    {
      "name": "PBD: Browser / JavaScript (rebuild Wasm)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:8000/pbd_model.html",
      "webRoot": "${workspaceFolder}",
      "userDataDir": "${workspaceFolder}/build/vscode/chrome-profile",
      "preLaunchTask": "PBD: Rebuild and serve"
    }
  ]
}
