{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "native-msvc",
      "displayName": "Simulation Lab / MSVC x64",
      "description": "Visual Studio 2026 C++20 core and native tests",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/native",
      "cacheVariables": {
        "BUILD_TESTING": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-msvc",
      "configuration": "Debug"
    },
    {
      "name": "native-release",
      "configurePreset": "native-msvc",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "native-release",
      "configurePreset": "native-msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
